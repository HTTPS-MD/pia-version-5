{
  // Hardened pia-ml-api (rule-based decision tree). Deploy to YOUR Cloudflare account, staging first.
  // Secret (never in this file, never in the browser):
  //   npx wrangler secret put ML_TOKEN --env staging
  "name": "pia-ml-api",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  // The Edge Function reaches the Worker over its workers.dev address. That is safe
  // here: every request needs the ML_TOKEN bearer secret (401 without it), the
  // Worker sends no CORS headers, and it never writes anything.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "env": {
    "staging": {
      "name": "pia-ml-api-staging",
      "workers_dev": true,
      "preview_urls": false
      // No KV namespace is needed: the rule-based decision tree reads and writes nothing.
    }
  }
}
